# =============================================================================
# asr-agent environment
#
# Copy this file to `.env` (in the repo root) and fill in the values.
# The three LIVEKIT_* entries are required by the local web server. The Colab
# bot also requires HF_TOKEN for the gated Cohere ASR model (Qwen3 is public).
#
# This same `.env` is used by BOTH the Colab bot (bot.py) and the local FastAPI
# server (backend/main.py) - they share the three LIVEKIT_* credentials.
# =============================================================================

# --- LiveKit Cloud (REQUIRED) -------------------------------------------------
# Your project URL, from the LiveKit console (Project -> API keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
# The API "key" for that project.
LIVEKIT_API_KEY=your_api_key
# The API "secret" for that project.
LIVEKIT_API_SECRET=your_api_secret
# LiveKit room the bot joins; the web app connects to the same room.
#LIVEKIT_ROOM=arabic-asr-live

# --- Cohere ASR model --------------------------------------------------------
# Cohere Transcribe Arabic is gated and requires HF_TOKEN.
#COHERE_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026
#COHERE_LANGUAGE=ar
# 4-bit-quantize the Cohere ASR model: saves VRAM at a small accuracy cost.
# Use it only if the fp16 translator does not fit beside it: 0 or 1 (default 0).
#COHERE_4BIT=1
# Hard ceiling on tokens the ASR/translator may generate per pass (default 448).
# This is a runaway guard only - the effective limit per request is derived from
# the input, and the bot logs a warning whenever a request actually hits it.
# Do NOT lower this to "save time": a cap that bites cuts transcripts and
# translations off mid-sentence.
#MAX_GEN_TOKENS=448
# Tokens budgeted per second of audio for the ASR (default 25). Raise it if the
# "ASR hit its ... budget" warning ever appears.
#ASR_TOKENS_PER_SECOND=25
# Translator output budget as a multiple of the source length (default 3.0).
#TRANSLATION_TOKEN_RATIO=3.0
# Longest speech segment (seconds) sent to the ASR before it is split (default 12).
#MAX_UTTERANCE_SECONDS=12
# Trailing silence (seconds) that ends an utterance once it already contains a
# full clause; lower responds faster (default 0.4).
#END_SILENCE_SECONDS=0.4
# A speaker pausing mid-sentence must not be split into fragments: below
# MIN_SENTENCE_SECONDS of actual speech, SHORT_SEGMENT_SILENCE_SECONDS of pause
# is required to close the segment instead. Fragmenting is expensive twice -
# the translator loses sentence context, and every extra turn pays the TTS
# engine's fixed per-call cost. Raise MIN_SENTENCE_SECONDS if sentences still
# arrive in pieces; lower it to shave latency off a fast, continuous speaker.
#MIN_SENTENCE_SECONDS=2.5
#SHORT_SEGMENT_SILENCE_SECONDS=1.0
# Live Arabic captions while someone is still speaking. They re-transcribe a
# growing buffer, so they run at the lowest priority and only while the
# ASR -> translation -> TTS path is completely idle. Set 0 for the absolute
# lowest latency: 0 or 1 (default 1).
#INTERIM_CAPTIONS=1

# --- Translation -------------------------------------------------------------
# Backend: qwen (default) or translategemma. TranslateGemma also requires
# accepting its Hugging Face model terms and an authorized HF_TOKEN.
#TRANSLATION_BACKEND=qwen
# Qwen3 is a public decoder-only chat model (no token or terms needed).
# 4B fits a T4 and is fast; pick an 8B variant for better translation quality.
#TRANSLATION_MODEL=Qwen/Qwen3-4B-Instruct-2507
#TRANSLATION_MODEL=Qwen/Qwen3-8B
# Kaggle dual-T4 profile: TRANSLATION_BACKEND=translategemma,
# TRANSLATION_MODEL=google/translategemma-12b-it, TRANSLATION_4BIT=1.
# TranslateGemma uses its official language-coded template. The Qwen system
# prompt and rolling context below do not apply to this backend.
# ISO 639-1 source / target language codes (default ar -> de = Arabic -> German):
#TRANSLATION_SOURCE_LANG=ar
#TRANSLATION_TARGET_LANG=de
# The translator uses a built-in system prompt tuned for a Friday sermon
# (Jumu'ah khutba) and remembers the last N translations (as chat context) so
# consecutive spoken fragments form a coherent rendering. Set 0 to disable the
# rolling context (a few hundred ms faster per translation):
#TRANSLATION_CONTEXT_TURNS=4
# Load the translator in 4-bit instead of fp16/bf16. 4-bit saves ~4 GB VRAM but
# decodes 2-4x slower on a T4 and translates slightly worse, so it is off by
# default; the bot falls back to it automatically if fp16 does not fit.
#TRANSLATION_4BIT=0
# Translator compute dtype: auto, float16, bfloat16 or float32. auto keeps the
# GPU default, but uses bfloat16 for TranslateGemma on float16 GPUs such as the
# T4: Gemma 3 activations exceed float16's range there and it then outputs only
# special tokens. bfloat16 is slower on a T4 but correct.
#TRANSLATION_DTYPE=auto
# Override the built-in sermon system prompt:
#TRANSLATION_SYSTEM_PROMPT=

# --- Per-stage device placement ----------------------------------------------
# Defaults: auto selects cuda:0 when available, otherwise CPU.
# The Kaggle notebook sets ASR and translation to cuda:0, TTS/codec to cuda:1.
#ASR_DEVICE=auto
#TRANSLATION_DEVICE=auto
#TTS_DEVICE=auto
# GPU_CONCURRENCY is the slot count PER DEVICE. Stages sharing a GPU share
# slots; separate devices can run simultaneously. The dual-T4 profile uses 1.

# --- HuggingFace token (needed for the gated Cohere ASR repo) -----------------
# A token from https://huggingface.co/settings/tokens. REQUIRED for the Cohere
# ASR repository. Open the model's page on huggingface.co, click to agree to
# its terms, then paste your token here. (Qwen3 is public and needs no token.)
HF_TOKEN=

# --- TTS: spoken output for the translation (optional) ------------------------
# Which TTS engine speaks the translation: "moss" (default) or "xtts".
#   moss -> MOSS-TTS (Apache-2.0). German and Arabic are both in its official
#           language list, and it speaks with a BUILT-IN voice: no reference
#           clip, nothing re-synthesised per call. Set MOSS_REF_WAV only if you
#           want to clone a specific voice.
#   xtts -> XTTS-v2, built-in German speakers (Coqui CPML license).
#TTS_BACKEND=moss

# --- MOSS-TTS (only used when TTS_BACKEND=moss) ------------------------------
# The current Local checkpoint has 3.06B parameters, plus a separate 1.77B
# float32 audio codec. The default combination does NOT fit a T4.
# Use a larger GPU (32 GiB+ recommended; e.g. Colab A100 40 GB).
#MOSS_MODEL=OpenMOSS-Team/MOSS-TTS-Local-Transformer
# Optional zero-shot voice cloning. Leave empty to use the built-in voice.
#MOSS_REF_WAV=
# RVQ inference depth, max 32. Lower is faster and less detailed - this is the
# speed/quality dial.
#MOSS_VQ_DEPTH=32
# Sampling, as recommended by the model card for the Local variant:
#MOSS_TEMPERATURE=1.0
#MOSS_TOP_P=0.95
#MOSS_TOP_K=50
#MOSS_REPETITION_PENALTY=1.1
# A T4 has no bf16 support, so the pipeline picks fp16. Try "float32" if
# fp16 produces non-finite audio (requires more VRAM). "bfloat16" needs Ampere+.
#MOSS_DTYPE=auto
# Run the TTS in a separate process with this directory first on its
# PYTHONPATH (empty = in-process). The Kaggle notebook sets it to a
# transformers 5.3.0 install, because MOSS's remote code breaks on >= 5.4
# while Cohere ASR requires >= 5.4.
#TTS_WORKER_PYTHONPATH=

# --- XTTS-v2 (only used when TTS_BACKEND=xtts) -------------------------------
# Leave both empty to use the built-in default voice.
#XTTS_SPEAKER=
#XTTS_SPEAKER_WAV=path/to/reference.wav

# --- Chunking of the spoken output -------------------------------------------
# Speak each finished clause as soon as the translator produced it instead of
# waiting for the whole sentence. This is the biggest win for time-to-first-
# audio: 0 or 1 (default 1).
#STREAM_TTS=1
# Target length in characters of the first / every later spoken chunk, and the
# length at which a chunk is forced even without punctuation.
#TTS_FIRST_CHUNK_CHARS=40
#TTS_CHUNK_CHARS=110
#TTS_MAX_CHUNK_CHARS=240
# Never hand the TTS a fragment shorter than this; short fragments sound clipped.
#TTS_MIN_CHUNK_CHARS=25

# --- Pipeline scheduling -----------------------------------------------------
# How many model calls may occupy the GPU at once. 2 lets the Python-side work
# of one stage overlap the CUDA kernels of another; raise only with spare VRAM.
#GPU_CONCURRENCY=2
# LiveKit's buffer in front of the audio encoder, in milliseconds.
#AUDIO_QUEUE_MS=800
# If the spoken output falls this many seconds behind, whole queued turns are
# skipped so the agent catches up instead of drifting forever. Skipping is per
# turn, never per chunk: the turn being spoken and the newest one are kept, so
# a sentence is never cut in half.
#MAX_AUDIO_BACKLOG_SECONDS=10
# Log level; DEBUG adds per-stage timings on top of the per-turn report.
#LOG_LEVEL=INFO
