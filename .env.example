# =============================================================================
# asr-agent environment
#
# Copy this file to `.env` (in the repo root) and fill in the values.
# The three LIVEKIT_* entries are required by the local web server. The Colab
# bot also requires HF_TOKEN for the gated Cohere and TranslateGemma models.
#
# This same `.env` is used by BOTH the Colab bot (bot.py) and the local FastAPI
# server (backend/main.py) - they share the three LIVEKIT_* credentials.
# =============================================================================

# --- LiveKit Cloud (REQUIRED) -------------------------------------------------
# Your project URL, from the LiveKit console (Project -> API keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
# The API "key" for that project.
LIVEKIT_API_KEY=your_api_key
# The API "secret" for that project.
LIVEKIT_API_SECRET=your_api_secret
# LiveKit room the bot joins; the web app connects to the same room.
#LIVEKIT_ROOM=arabic-asr-live

# --- Cohere ASR model --------------------------------------------------------
# Cohere Transcribe Arabic is gated and requires HF_TOKEN.
#COHERE_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026
#COHERE_LANGUAGE=ar
# 4-bit-quantize the Cohere ASR model to save VRAM: 0 or 1 (default 0).
#COHERE_4BIT=0
# Longest speech segment (seconds) sent to the ASR before it is split (default 12).
#MAX_UTTERANCE_SECONDS=12

# --- Translation -------------------------------------------------------------
# TranslateGemma is gated and requires HF_TOKEN.
# Pick the size: 12B is the default (best quality); 4B uses less VRAM and is
# faster. Set GEMMA_TRANSLATION_MODEL to whichever one you want to use:
#GEMMA_TRANSLATION_MODEL=google/translategemma-12b-it
#GEMMA_TRANSLATION_MODEL=google/translategemma-4b-it
# ISO 639-1 source / target language codes (default ar -> de = Arabic -> German):
#TRANSLATION_SOURCE_LANG=ar
#TRANSLATION_TARGET_LANG=de

# --- HuggingFace token (needed for gated model repos) -------------------------
# A token from https://huggingface.co/settings/tokens. REQUIRED for the Cohere
# ASR and TranslateGemma model repositories. Open each model's page on huggingface.co,
# click to agree to its terms, then paste your token here.
HF_TOKEN=

# --- TTS: spoken output for the translation (optional) ------------------------
# Which TTS engine speaks the translation: "f5" (default) or "xtts".
#   f5   -> F5-TTS: German targets speak the German fine-tune
#           aihpi/F5-TTS-German, other targets (e.g. English) speak the
#           standard F5-TTS base model.
#   xtts -> XTTS-v2 (previous engine).
#TTS_BACKEND=f5
# F5-TTS is a voice-cloning model: it needs a short reference clip (~5-10 s) of
# the desired voice AND its exact spoken text. For German, use a German clip.
# F5_REF_WAV: file in the Colab runtime (e.g. /content/reference.wav) or http(s) URL.
#F5_REF_WAV=path/to/reference.wav
# The spoken text of the reference clip (in the target language):
#F5_REF_TEXT=
# Which German checkpoint to use (repo:directory/file). Checkpoints: 295000, 365000, 420000.
#F5_GERMAN_REPO=aihpi/F5-TTS-German
#F5_GERMAN_CKPT=F5TTS_Base/model_420000.safetensors
# Load EMA weights (recommended for the fully fine-tuned checkpoints): 0 or 1 (default 1).
#F5_USE_EMA=1
# ODE inference steps, lower is faster: 1-100 (default 32).
#F5_NFE_STEPS=32
# XTTS-v2, only used when TTS_BACKEND=xtts. Leave both empty to use the built-in default voice.
#XTTS_SPEAKER=
#XTTS_SPEAKER_WAV=path/to/reference.wav

