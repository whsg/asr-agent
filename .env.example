# =============================================================================
# asr-agent environment
#
# Copy this file to `.env` (in the repo root) and fill in the values.
# Only the three LIVEKIT_* entries at the top are required; every other line
# is optional and already has a working default.
#
# This same `.env` is used by BOTH the Colab bot (bot.py) and the local FastAPI
# server (backend/main.py) - they share the three LIVEKIT_* credentials.
# =============================================================================

# --- LiveKit Cloud (REQUIRED) -------------------------------------------------
# Your project URL, from the LiveKit console (Project -> API keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
# The API "key" for that project.
LIVEKIT_API_KEY=your_api_key
# The API "secret" for that project.
LIVEKIT_API_SECRET=your_api_secret
# LiveKit room the bot joins; the web app connects to the same room.
#LIVEKIT_ROOM=qwen-asr-live

# --- ASR backends (optional) --------------------------------------------------
# Which ASR engine(s) to load in Colab: "qwen", "cohere" or "qwen,cohere".
#   qwen        -> Qwen/Qwen3-ASR-1.7B                        (default)
#   cohere      -> CohereLabs/cohere-transcribe-arabic-07-2026 (gated, needs HF_TOKEN)
#   qwen,cohere -> run both, shown side by side in the web UI
#ASR_BACKENDS=qwen
# Override the ASR model ids (defaults shown):
#QWEN_MODEL=Qwen/Qwen3-ASR-1.7B
#COHERE_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026
# Language the ASR transcribes (default: Arabic):
#QWEN_LANGUAGE=Arabic
#COHERE_LANGUAGE=ar
# 4-bit-quantize the Cohere ASR model to save VRAM: 0 or 1 (default 0).
#COHERE_4BIT=0
# Longest speech segment (seconds) sent to the ASR before it is split (default 12).
#MAX_UTTERANCE_SECONDS=12

# --- Translation (optional) ---------------------------------------------------
# Which translator to load: "translategemma" (default) or "qwen3".
# Exactly ONE is loaded at startup - never both.
#   translategemma -> google/translategemma-12b-it  (gated, needs HF_TOKEN)
#   qwen3          -> Qwen/Qwen3-8B                 (not gated, keeps last 3 lines as context)
#TRANSLATION_BACKEND=translategemma
# Override the translator model ids (defaults shown):
#GEMMA_TRANSLATION_MODEL=google/translategemma-12b-it
#QWEN_TRANSLATION_MODEL=Qwen/Qwen3-8B
# ISO 639-1 source / target language codes (default ar -> de = Arabic -> German):
#TRANSLATION_SOURCE_LANG=ar
#TRANSLATION_TARGET_LANG=de

# --- HuggingFace token (needed for gated model repos) -------------------------
# A token from https://huggingface.co/settings/tokens. REQUIRED when you use a gated
# repo - i.e. when TRANSLATION_BACKEND=translategemma (the default, which is gated)
# or when you enable the "cohere" ASR backend. Open the model's page on huggingface.co,
# click to agree to its terms, then paste your token here.
#HF_TOKEN=

# --- TTS: German speech output (optional) -------------------------------------
# Reference voice for XTTS-v2. Leave both empty to use the built-in default voice.
#XTTS_SPEAKER=
#XTTS_SPEAKER_WAV=path/to/reference.wav

