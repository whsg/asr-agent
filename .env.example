# =============================================================================
# asr-agent environment
#
# Copy this file to `.env` (in the repo root) and fill in the values.
# The three LIVEKIT_* entries are required by the local web server. The Colab
# bot also requires HF_TOKEN for the gated Cohere ASR model (Qwen3 is public).
#
# This same `.env` is used by BOTH the Colab bot (bot.py) and the local FastAPI
# server (backend/main.py) - they share the three LIVEKIT_* credentials.
# =============================================================================

# --- LiveKit Cloud (REQUIRED) -------------------------------------------------
# Your project URL, from the LiveKit console (Project -> API keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
# The API "key" for that project.
LIVEKIT_API_KEY=your_api_key
# The API "secret" for that project.
LIVEKIT_API_SECRET=your_api_secret
# LiveKit room the bot joins; the web app connects to the same room.
#LIVEKIT_ROOM=arabic-asr-live

# --- Cohere ASR model --------------------------------------------------------
# Cohere Transcribe Arabic is gated and requires HF_TOKEN.
#COHERE_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026
#COHERE_LANGUAGE=ar
# 4-bit-quantize the Cohere ASR model: saves ~3 GB VRAM and roughly halves ASR
# decode time on a T4, at a small accuracy cost. Recommended 1 on a T4: 0 or 1 (default 0).
#COHERE_4BIT=1
# Cap on tokens the ASR/translator may generate per pass (default 512). Lowering
# it guards against runaway generation; 512 comfortably fits a 20 s utterance.
#MAX_GEN_TOKENS=512
# Longest speech segment (seconds) sent to the ASR before it is split (default 20).
#MAX_UTTERANCE_SECONDS=20
# Trailing silence (seconds) that ends an utterance; lower responds faster (default 1.0).
#END_SILENCE_SECONDS=1.0
# Note: while a reply (translation/TTS) is queued or speaking, live captions
# are automatically paused so they cannot delay the spoken answer.

# --- Translation -------------------------------------------------------------
# Qwen3 is a public decoder-only chat model (no token or terms needed).
# 4B fits a T4 and is fast; pick an 8B variant for better translation quality.
#TRANSLATION_MODEL=Qwen/Qwen3-4B-Instruct-2507
#TRANSLATION_MODEL=Qwen/Qwen3-8B
# ISO 639-1 source / target language codes (default ar -> de = Arabic -> German):
#TRANSLATION_SOURCE_LANG=ar
#TRANSLATION_TARGET_LANG=de
# The translator uses a built-in system prompt tuned for a Friday sermon
# (Jumu'ah khutba) and remembers the last N source/translation pairs (as chat
# context) so consecutive spoken fragments form a coherent rendering. It is a
# streaming interpreter: it releases complete, compact sentences and may hold
# back source text (in an internal "pending" buffer) until its continuation
# arrives, so output stays coherent. Set 0 to disable the rolling context
# (a few hundred ms faster per translation):
#TRANSLATION_CONTEXT_TURNS=5

# --- HuggingFace token (needed for the gated Cohere ASR repo) -----------------
# A token from https://huggingface.co/settings/tokens. REQUIRED for the Cohere
# ASR repository. Open the model's page on huggingface.co, click to agree to
# its terms, then paste your token here. (Qwen3 is public and needs no token.)
HF_TOKEN=

# --- TTS: spoken output for the translation (optional) ------------------------
# Which TTS engine speaks the translation: "phonon" (default) or "xtts".
#   phonon -> Gradium Phonon model for German (gradium/phonon-40m-de).
#             Lightweight, doesn't require voice cloning: it speaks with a
#             fixed speaker from gradium/phonon-voices (PHONON_VOICE, default
#             "henrik"). The model repo is gated, so it needs HF_TOKEN plus
#             accepted license terms on Hugging Face.
#   xtts   -> XTTS-v2 (previous engine).
#TTS_BACKEND=phonon
# XTTS-v2, only used when TTS_BACKEND=xtts. Leave both empty to use the built-in default voice.
#XTTS_SPEAKER=
#XTTS_SPEAKER_WAV=path/to/reference.wav
# Gradium Phonon model, only used when TTS_BACKEND=phonon. German language model.
#PHONON_MODEL_NAME=gradium/phonon-40m-de
# Which speaker Phonon uses: a voice name from gradium/phonon-voices (e.g.
# "henrik", the default), a raw 16-char voice ID, or "default" for the
# checkpoint's built-in voice.
#PHONON_VOICE=henrik
# Phonon inference sampling parameter (lower is more deterministic):
#PHONON_TEMPERATURE=1.0
# NOTE: the Phonon repo is gated - accept its license on Hugging Face and set
# HF_TOKEN above. Also needs a transformers build with
# GradiumPhononTTSForConditionalGeneration (pip install -U
# 'git+https://github.com/huggingface/transformers').

